{
  "name": "getcourse-ai-homework-checker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.18.1"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "knowledge:import": "tsx scripts/import-knowledge.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
